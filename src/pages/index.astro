---
import Layout from '../layouts/Layout.astro';

const cast = [
  { first: 'Giacomo', last: 'Bartoccioli' },
  { first: 'Diletta', last: 'Cappannini' },
  { first: 'Gabriele', last: 'Nardi' },
  { first: 'Jacopo', last: 'Vitali' },
  { first: 'Guglielmo', last: 'Sergio' },
  { first: 'Nicole', last: 'Vincenti' },
];

const mainVideo = 'ztNIJ_Evy7I';
const coProductions = ['rqSI7KSt0oA', 'gHr7xGiuGao'];
const events = ['8tZaO7tuMo4'];

const embed = (id: string) => `https://www.youtube.com/embed/${id}?rel=0`;
const allow =
  'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
---

<Layout>
  <!-- ===== APERTURA CINEMA ===== -->
    <div class="intro" aria-hidden="true">
    <div class="intro-top"></div>
    <div class="intro-bottom"></div>
    <div class="intro-glow"></div>
    <div class="intro-line"></div>
  </div>

  <!-- ===== SFONDO ANIMATO ===== -->
  <div class="stage" aria-hidden="true">
    <div class="stage-img" style="background-image: url('/hero-bg.jpg');"></div>
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="orb orb-c"></div>
    <canvas id="embers"></canvas>
    <div class="vignette"></div>
    <div class="grain"></div>
  </div>

  <div class="pt-[88px] md:pt-44 pb-6 md:pb-8 px-5 md:px-10 flex flex-col items-center text-center text-white relative">

    <!-- Righe copyright -->
    <p class="rv font-['Helvetica'] font-bold uppercase text-[11px] md:text-base leading-relaxed max-w-4xl" style="--d:2.2s">
      <span class="block md:inline">© Cicala Corporation</span>{' '}
      <span class="block md:inline">is the production and distribution company.</span>
      <span class="hidden md:block"></span>
      <span class="block md:inline">"2K Alla Chiave" is the debut film.</span>
    </p>

    <!-- TITOLO -->
    <div class="title-wrap mt-6 md:mt-10">
      <img
        src="/2kallachiave.png"
        alt="2K Alla Chiave"
        class="title-img w-[92vw] max-w-[900px] h-auto"
      />
    </div>

    <!-- CAST -->
    <ul class="font-benguiat uppercase mt-8 md:mt-14 space-y-2 md:space-y-5">
      {cast.map((p) => (
        <li class="rv" style={`--d:0s`}>
          <span class="block text-xs md:text-sm tracking-wide leading-tight">{p.first}</span>
          <span class="block text-xl md:text-3xl tracking-wide leading-tight">{p.last}</span>
        </li>
      ))}
    </ul>

    <!-- COMING IN 2026 -->
    <div class="rv mt-12 md:mt-20 flex flex-col items-center" style="--d:0s">
      <span class="coming-line"></span>
      <p class="font-['Helvetica'] font-bold uppercase mt-5 tracking-[0.12em] text-2xl md:text-4xl">
        Coming in 2026
      </p>
    </div>

    <!-- VIDEO PRINCIPALE -->
    <div class="rv video-frame w-full max-w-4xl mt-8 md:mt-10 aspect-video" style="--d:0s">
      <iframe
        src={embed(mainVideo)}
        title="2K Alla Chiave"
        class="w-full h-full rounded-sm"
        frameborder="0"
        allow={allow}
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
    <!-- STAY UPDATED ON INSTAGRAM -->
    <a
      href="https://www.instagram.com/2kallachiave"
      target="_blank"
      rel="noopener noreferrer"
      class="rv ig-link mt-6 md:mt-8 inline-flex items-center gap-3 font-['Helvetica'] font-bold text-xs md:text-sm tracking-[0.12em]"
      style="--d:0s"
      aria-label="Stay updated on Instagram"
    >
      <span>Stay updated on Instagram</span>
      <svg viewBox="0 0 24 24" class="w-6 h-6 md:w-7 md:h-7">
        <defs>
          <linearGradient id="ig-grad-home" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#FFDC80"/>
            <stop offset="25%" stop-color="#FCAF45"/>
            <stop offset="50%" stop-color="#F56040"/>
            <stop offset="75%" stop-color="#E1306C"/>
            <stop offset="100%" stop-color="#833AB4"/>
          </linearGradient>
        </defs>
        <path
          fill="url(#ig-grad-home)"
          d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
        />
      </svg>
    </a>

    <!-- CO-PRODUCTIONS -->
    <h2 class="rv font-['Helvetica'] font-bold uppercase mt-16 md:mt-24 mb-6 tracking-[0.12em] text-2xl md:text-4xl" style="--d:0s">
      Co-Productions
    </h2>

    <!-- Mobile: copertine a scorrimento (tocca per avviare il video) -->
    <div class="md:hidden w-[100vw]">
      <div
        id="coprod-track"
        class="flex gap-4 overflow-x-auto px-5 hide-scrollbar"
        style="overscroll-behavior-x: contain;"
      >
        {coProductions.map((id) => (
          <div
            class="yt-card relative flex-none w-[82vw] aspect-video rounded-sm bg-black bg-cover bg-center cursor-pointer"
            data-id={id}
            style={`background-image:url(https://i.ytimg.com/vi/${id}/hqdefault.jpg)`}
          >
            <span class="absolute inset-0 flex items-center justify-center pointer-events-none">
              <svg viewBox="0 0 68 48" class="w-16 h-11 drop-shadow-lg">
                <rect width="68" height="48" rx="12" fill="#FF0000" />
                <path d="M27 14v20l18-10z" fill="#fff" />
              </svg>
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Desktop: due lettori affiancati -->
    <div class="hidden md:grid grid-cols-2 gap-8 w-full max-w-6xl">
      {coProductions.map((id, i) => (
        <div class="rv video-frame aspect-video" style={`--d:${i * 0.15}s`}>
          <iframe
            src={embed(id)}
            title="Co-production"
            class="w-full h-full rounded-sm"
            frameborder="0"
            allow={allow}
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      ))}
    </div>

    <!-- EVENTS -->
    <h2 class="rv font-['Helvetica'] font-bold uppercase mt-16 md:mt-24 mb-6 tracking-[0.12em] text-2xl md:text-4xl" style="--d:0s">
      Events
    </h2>
    <div class="w-full max-w-4xl">
      {events.map((id) => (
        <div class="rv video-frame aspect-video" style="--d:0s">
          <iframe
            src={embed(id)}
            title="Events"
            class="w-full h-full rounded-sm"
            frameborder="0"
            allow={allow}
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      ))}
    </div>

  </div>
</Layout>

<style is:global>
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar { display: none; }

  /* ---------- Apertura cinema ---------- */
  .intro { position: fixed; inset: 0; z-index: 45; pointer-events: none; animation: introDone 0s 3.1s forwards; }
  .intro-top, .intro-bottom {
    position: absolute; left: 0; right: 0; height: calc(50% + 140px);
    animation-duration: 1.9s; animation-delay: 0.95s; animation-fill-mode: forwards;
    animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform, opacity;
  }
  .intro-top {
    top: 0; animation-name: openTop;
    background: linear-gradient(to bottom,
      #000 0, #000 calc(100% - 140px),
      rgba(0,0,0,.92) calc(100% - 112px), rgba(0,0,0,.72) calc(100% - 84px),
      rgba(0,0,0,.45) calc(100% - 56px), rgba(0,0,0,.2) calc(100% - 28px),
      rgba(0,0,0,0) 100%);
  }
  .intro-bottom {
    bottom: 0; animation-name: openBottom;
    background: linear-gradient(to top,
      #000 0, #000 calc(100% - 140px),
      rgba(0,0,0,.92) calc(100% - 112px), rgba(0,0,0,.72) calc(100% - 84px),
      rgba(0,0,0,.45) calc(100% - 56px), rgba(0,0,0,.2) calc(100% - 28px),
      rgba(0,0,0,0) 100%);
  }
    .intro-line {
    position: absolute; left: 50%; top: 50%; height: 2px; width: 0;
    transform: translate(-50%, -50%);
    background: linear-gradient(90deg, transparent, #ff3a14 18%, #ff8a50 50%, #ff3a14 82%, transparent);
    box-shadow: 0 0 18px 2px rgba(255, 60, 30, 0.8);
    animation:
      lineGrow 0.9s 0.1s cubic-bezier(0.22, 1, 0.36, 1) forwards,
      lineFade 1.1s 0.85s cubic-bezier(0.4, 0, 0.6, 1) forwards;
  }
  @keyframes lineGrow { to { width: min(70vw, 700px); } }
  @keyframes lineFade {
    0%   { opacity: 1; height: 2px;  width: min(70vw, 700px); filter: blur(0); }
    100% { opacity: 0; height: 14px; width: 120vw;            filter: blur(8px); }
  }

  /* Luce che trabocca dalla fessura mentre il sipario si apre */
  .intro-glow {
    position: absolute; left: 0; right: 0; top: 50%; height: 90vh;
    margin-top: -45vh; opacity: 0; transform: scaleY(0.004);
    background: radial-gradient(ellipse 70% 50% at 50% 50%,
      rgba(255, 110, 50, 0.55) 0%, rgba(255, 50, 20, 0.22) 38%, transparent 72%);
    filter: blur(14px); mix-blend-mode: screen; will-change: transform, opacity;
    animation: glowOpen 2s 0.8s cubic-bezier(0.45, 0, 0.25, 1) forwards;
  }
  @keyframes glowOpen {
    0%   { opacity: 0;   transform: scaleY(0.004); }
    18%  { opacity: 0.9; transform: scaleY(0.08); }
    55%  { opacity: 0.7; transform: scaleY(0.7); }
    100% { opacity: 0;   transform: scaleY(1.1); }
  }
  @keyframes openTop { 70% { opacity: 1; } to { transform: translateY(-101%); opacity: 0; } }
  @keyframes openBottom { 70% { opacity: 1; } to { transform: translateY(101%); opacity: 0; } }
  @keyframes introDone { to { visibility: hidden; } }

  /* ---------- Sfondo ---------- */
  .stage { position: fixed; inset: 0; z-index: -10; background: #050000; overflow: hidden; }
  .stage-img {
    position: absolute; inset: -4%; background-size: cover; background-position: center;
    filter: blur(6px) brightness(0.45) saturate(1.2);
    animation: kenburns 28s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes kenburns { from { transform: scale(1) translate3d(0, 0, 0); } to { transform: scale(1.12) translate3d(-1.5%, -1%, 0); } }

  .orb { position: absolute; border-radius: 50%; filter: blur(70px); mix-blend-mode: screen; opacity: 0.55; will-change: transform; }
  .orb-a { width: 60vmax; height: 60vmax; left: -15vmax; top: -10vmax; background: radial-gradient(circle, #ff3a14 0%, transparent 65%); animation: driftA 22s ease-in-out infinite alternate; }
  .orb-b { width: 50vmax; height: 50vmax; right: -15vmax; top: 30vh; background: radial-gradient(circle, #ff8a1f 0%, transparent 65%); opacity: 0.35; animation: driftB 26s ease-in-out infinite alternate; }
  .orb-c { width: 45vmax; height: 45vmax; left: 20vw; bottom: -20vmax; background: radial-gradient(circle, #b3001b 0%, transparent 65%); animation: driftC 30s ease-in-out infinite alternate; }
  @keyframes driftA { to { transform: translate3d(18vw, 14vh, 0) scale(1.15); } }
  @keyframes driftB { to { transform: translate3d(-20vw, -12vh, 0) scale(0.9); } }
  @keyframes driftC { to { transform: translate3d(10vw, -16vh, 0) scale(1.2); } }

  #embers { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cursor-glow {
    position: absolute; left: 0; top: 0; width: 520px; height: 520px; margin: -260px 0 0 -260px;
    background: radial-gradient(circle, rgba(255, 90, 40, 0.22), transparent 65%);
    mix-blend-mode: screen; opacity: 0; transition: opacity 0.6s ease; will-change: transform;
  }
  .vignette { position: absolute; inset: 0; background: radial-gradient(ellipse at center, transparent 35%, rgba(0, 0, 0, 0.85) 100%); }
  .grain {
    position: absolute; inset: -50%; opacity: 0.09; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    animation: grain 0.9s steps(6) infinite;
  }
  @keyframes grain {
    0% { transform: translate(0, 0); } 20% { transform: translate(-6%, 4%); } 40% { transform: translate(5%, -7%); }
    60% { transform: translate(-4%, -3%); } 80% { transform: translate(7%, 5%); } 100% { transform: translate(0, 0); }
  }

  /* ---------- Titolo ---------- */
  .title-img {
    opacity: 0; filter: blur(22px); transform: scale(1.12);
    animation: titleIn 2s 1.7s cubic-bezier(0.22, 1, 0.36, 1) forwards, titleGlow 4.5s 3.7s ease-in-out infinite;
  }
  @keyframes titleIn { to { opacity: 1; filter: blur(0) drop-shadow(0 0 14px rgba(255, 255, 255, 0.35)); transform: scale(1); } }
  @keyframes titleGlow {
    0%, 100% { filter: blur(0) drop-shadow(0 0 10px rgba(255, 255, 255, 0.25)); }
    50% { filter: blur(0) drop-shadow(0 0 30px rgba(255, 150, 90, 0.65)); }
  }

  /* ---------- Comparsa allo scroll ---------- */
  .rv {
    opacity: 0; transform: translateY(30px); filter: blur(8px);
    transition: opacity 1s ease, transform 1s cubic-bezier(0.22, 1, 0.36, 1), filter 1s ease;
    transition-delay: var(--d, 0s);
  }
  .rv.in { opacity: 1; transform: none; filter: blur(0); }

  .coming-line { display: block; width: 0; height: 2px; background: #cc0000; box-shadow: 0 0 14px rgba(255, 60, 30, 0.8); transition: width 1.4s cubic-bezier(0.22, 1, 0.36, 1) 0.2s; }
  .rv.in .coming-line { width: min(60vw, 320px); }

  .video-frame { box-shadow: 0 0 0 rgba(255, 90, 40, 0); transition: opacity 1s ease, transform 1s cubic-bezier(0.22, 1, 0.36, 1), filter 1s ease, box-shadow 0.6s ease; }
  .video-frame.in { box-shadow: 0 10px 60px rgba(255, 70, 30, 0.18); }

  /* ---------- Riduci movimento ---------- */
  @media (prefers-reduced-motion: reduce) {
    .intro { display: none; }
    .stage-img, .orb, .grain, .title-img { animation: none !important; }
    .title-img { opacity: 1; filter: none; transform: none; }
    .rv { opacity: 1; transform: none; filter: none; transition: none; }
    .coming-line { width: min(60vw, 320px); transition: none; }
  }
    /* ---------- Sfumatura sfondo → footer nero (solo Home) ---------- */
  .site-footer {
    background: linear-gradient(to bottom,
      rgba(0, 0, 0, 0) 0,
      rgba(0, 0, 0, 0.35) 50px,
      rgba(0, 0, 0, 0.7) 110px,
      rgba(0, 0, 0, 0.92) 170px,
      #000 230px) !important;
  }
  
  /* ---------- Link Instagram sotto il teaser ---------- */
  .ig-link { color: #fff; opacity: 0; transition: opacity 1s ease, transform 1s cubic-bezier(0.22, 1, 0.36, 1), filter 1s ease; }
  .ig-link.in { opacity: 0.85; }
  .ig-link.in:hover { opacity: 1; }
  .ig-link svg { transition: transform 0.25s ease; }
  .ig-link:hover svg { transform: scale(1.15) rotate(-6deg); }
</style>

<script>
  import { autoScroll } from '../scripts/autoscroll.js';

  function setupHome() {
    // ---------- Comparsa allo scroll ----------
    const items = document.querySelectorAll('.rv');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            en.target.classList.add('in');
            io.unobserve(en.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -6% 0px' }
    );
    items.forEach((el) => io.observe(el));

    // ---------- Braci ----------
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canvas = document.getElementById('embers') as HTMLCanvasElement | null;
    if (canvas && !reduce && !canvas.dataset.init) {
      canvas.dataset.init = 'true';
      const ctx = canvas.getContext('2d') as CanvasRenderingContext2D;
      let w = 0, h = 0, dpr = 1;
      let particles: any[] = [];
      let raf = 0;

      // Sprite pre-disegnati: dal bianco-giallo (caldo) al rosso scuro (freddo)
      const stops = [
        [170, 25, 10],
        [255, 70, 20],
        [255, 130, 40],
        [255, 185, 90],
        [255, 235, 190],
      ];
      const sprites: HTMLCanvasElement[] = stops.map(([r, g, b]) => {
        const c = document.createElement('canvas');
        c.width = c.height = 64;
        const x = c.getContext('2d') as CanvasRenderingContext2D;
        const gr = x.createRadialGradient(32, 32, 0, 32, 32, 32);
        gr.addColorStop(0, `rgba(255,255,255,1)`);
        gr.addColorStop(0.12, `rgba(${r},${g},${b},0.95)`);
        gr.addColorStop(0.4, `rgba(${r},${g},${b},0.35)`);
        gr.addColorStop(1, `rgba(${r},${g},${b},0)`);
        x.fillStyle = gr;
        x.fillRect(0, 0, 64, 64);
        return c;
      });

      const spawn = (anywhere = false) => {
        const big = Math.random() < 0.12;
        return {
          x: Math.random() * w,
          y: anywhere ? h * (0.3 + Math.random() * 0.7) : h + 10 + Math.random() * 40,
          vy: (big ? 28 : 40) + Math.random() * 55,
          vx: 0,
          size: big ? 3 + Math.random() * 2.5 : 1 + Math.random() * 2,
          temp: anywhere ? Math.random() : 0.85 + Math.random() * 0.15,
          cool: 0.1 + Math.random() * 0.14,
          ph: Math.random() * 6.28,
          fl: 6 + Math.random() * 10,
          wob: 8 + Math.random() * 22,
          wsp: 0.8 + Math.random() * 1.6,
          px: 0, py: 0,
        };
      };

      const resize = () => {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = window.innerWidth;
        h = window.innerHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = w < 768 ? 26 : 55;
        particles = Array.from({ length: count }, () => spawn(true));
      };

      let last = performance.now();
      let time = 0;
      const frame = (now: number) => {
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;
        time += dt;

        // vento lento che cambia, con raffiche
        const wind = Math.sin(time * 0.25) * 22 + Math.sin(time * 0.9) * 8;

        ctx.clearRect(0, 0, w, h);
        ctx.globalCompositeOperation = 'lighter';

        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          p.px = p.x; p.py = p.y;

          p.ph += p.wsp * dt;
          const targetVx = wind + Math.sin(p.ph) * p.wob + Math.sin(p.ph * 2.7) * p.wob * 0.3;
          p.vx += (targetVx - p.vx) * Math.min(1, dt * 1.6);
          p.x += p.vx * dt;
          p.y -= p.vy * dt;
          p.vy *= 1 - 0.04 * dt;      // sale sempre più piano
          p.temp -= p.cool * dt;

          if (p.temp <= 0 || p.y < -20 || p.x < -40 || p.x > w + 40) {
            particles[i] = spawn();
            continue;
          }

          const flicker = 0.7 + 0.3 * Math.sin(time * p.fl + p.ph * 3);
          const fadeTop = Math.min(1, p.y / (h * 0.25));
          const alpha = Math.min(1, p.temp * 1.6) * flicker * fadeTop;
          const sz = p.size * (0.45 + p.temp * 0.75) * 6;
          const idx = Math.min(sprites.length - 1, Math.floor(p.temp * sprites.length));

          // scia sottile
          const dx = p.x - p.px, dy = p.y - p.py;
          if (p.temp > 0.35) {
            ctx.globalAlpha = alpha * 0.35;
            ctx.strokeStyle = p.temp > 0.65 ? 'rgba(255,190,110,1)' : 'rgba(255,100,40,1)';
            ctx.lineWidth = Math.max(0.6, p.size * 0.5);
            ctx.beginPath();
            ctx.moveTo(p.x - dx * 6, p.y - dy * 6);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
          }

          ctx.globalAlpha = alpha;
          ctx.drawImage(sprites[idx], p.x - sz / 2, p.y - sz / 2, sz, sz);
        }
        ctx.globalAlpha = 1;
        raf = requestAnimationFrame(frame);
      };

      resize();
      window.addEventListener('resize', resize);
      document.addEventListener('visibilitychange', () => {
        cancelAnimationFrame(raf);
        if (!document.hidden) { last = performance.now(); raf = requestAnimationFrame(frame); }
      });
      raf = requestAnimationFrame(frame);
    }

    // ---------- Alone sul mouse + parallax (solo desktop) ----------
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const glow = document.getElementById('cursor-glow');
    const bg = document.querySelector('.stage-img') as HTMLElement | null;
    if (fine && !reduce && glow && !glow.dataset.init) {
      glow.dataset.init = 'true';
      let tx = 0, ty = 0, cx = 0, cy = 0, sy = 0, ticking = false;
      const update = () => {
        cx += (tx - cx) * 0.18;
        cy += (ty - cy) * 0.18;
        glow.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
        if (bg) bg.style.marginTop = `${-sy * 0.05}px`;
        if (Math.abs(tx - cx) > 0.5 || Math.abs(ty - cy) > 0.5) requestAnimationFrame(update);
        else ticking = false;
      };
      window.addEventListener('mousemove', (e) => {
        tx = e.clientX; ty = e.clientY;
        glow.style.opacity = '1';
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      });
      window.addEventListener('scroll', () => {
        sy = window.scrollY;
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
    }

    // ---------- Co-Productions mobile ----------
    const track = document.getElementById('coprod-track');
    if (track && !track.dataset.init) {
      track.dataset.init = 'true';

      track.addEventListener('click', (e) => {
        const card = (e.target as HTMLElement).closest('.yt-card');
        if (!card || card.classList.contains('is-playing')) return;
        const id = card.getAttribute('data-id');
        card.classList.add('is-playing');
        (card as HTMLElement).style.backgroundImage = 'none';
        card.innerHTML =
          '<iframe src="https://www.youtube.com/embed/' + id +
          '?autoplay=1&playsinline=1&rel=0" title="Co-production" ' +
          'class="w-full h-full rounded-sm" frameborder="0" ' +
          'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" ' +
          'allowfullscreen></iframe>';
      });

      if (window.matchMedia('(max-width: 767px)').matches) {
        autoScroll(track, {
          speed: 35,
          resumeMs: 1000,
          isBlocked: () => !!track.querySelector('.is-playing'),
        });
      }
    }
  }

  setupHome();
  document.addEventListener('astro:page-load', setupHome);
</script>