---

<Layout
  title="About | Cicala Corporation"
  description="Cicala Corporation is a film production and distribution company delivering cinematic content and screen-ready commercials."
>
  <about-page data-active="en" class="block pt-24 md:pt-32 pb-0 text-white">

    <!-- LOGO -->
    <div class="flex justify-center px-6">
      <img
        src={fullLogo.src}
        alt="Cicala Corporation"
        class="w-56 md:w-96 h-auto"
      />
    </div>

    <!-- BANDIERINE -->
    <div class="flex items-center justify-center gap-3 mt-3 md:mt-5">
      {flags.map((f, i) => (
        <button
          type="button"
          class:list={['flag-btn', { 'is-active': i === 0 }]}
          data-lang={f.code}
          aria-label={f.label}
          title={f.label}
        >
          <Fragment set:html={f.svg} />
        </button>
      ))}
    </div>

    <!-- TESTO -->
    <div class="font-benguiat max-w-4xl mx-auto px-6 mt-4 md:mt-8 text-center space-y-8 md:space-y-10">
      {paragraphs.map((p) => (
        <p class="ml reveal text-[15px] md:text-lg leading-[1.9] md:leading-[2]">
          {langs.map((l) => <span lang={l}>{p[l]}</span>)}
        </p>
      ))}
    </div>

    <!-- TEAM -->
    <h2 class="font-['Helvetica'] font-bold text-center mt-20 md:mt-28 mb-10 tracking-wide text-2xl md:text-4xl">
      The trusted ones
    </h2>

    <div class="max-w-7xl mx-auto md:px-10">
      <div
        id="team-track"
        class="team-track flex gap-5 overflow-x-auto px-6 pb-0 scroll-px-6 hide-scrollbar md:grid md:grid-cols-4 md:gap-6 md:overflow-visible md:px-0"
      >
        {team.map((m, i) => (
          <article
            class="team-card reveal snap-start flex-none w-[78vw] max-w-[340px] md:w-auto md:max-w-none bg-white text-black rounded-sm overflow-hidden shadow-xl flex flex-col group font-['Helvetica']"
            style={`--d:${i * 120}ms`}
          >
            <div class="aspect-[4/3] bg-neutral-300 overflow-hidden">
              <img
                src={m.photo}
                alt={m.name}
                class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105 select-none"
                loading="lazy"
                draggable="false"
              />
            </div>

            <div class="p-6 md:p-7 flex flex-col flex-1">
              <h3 class="font-bold text-lg md:text-xl leading-tight">{m.name}</h3>
              <p class="ml text-sm leading-relaxed text-neutral-800 mt-3">
                {langs.map((l) => <span lang={l}>{m.bio[l]}</span>)}
              </p>

              <div class="flex flex-wrap items-center gap-3 mt-auto pt-5">
                {Object.entries(m.links).map(([key, url]) => (
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${m.name} - ${key}`}
                    draggable="false"
                    class="inline-flex hover:scale-110 transition-transform duration-200"
                  >
                    <svg viewBox="0 0 24 24" class="w-5 h-5" fill={icons[key].color}>
                      <path d={icons[key].d} />
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

  </about-page>
</Layout>

<style is:global>
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }

  /* Lingue: si vede solo quella attiva (anche nelle card clonate su mobile) */
  .ml > [lang] { display: none; }
  about-page[data-active="en"] .ml > [lang="en"],
  about-page[data-active="it"] .ml > [lang="it"],
  about-page[data-active="fr"] .ml > [lang="fr"],
  about-page[data-active="es"] .ml > [lang="es"],
  about-page[data-active="ja"] .ml > [lang="ja"] { display: inline; }

  /* Bandierine (stessa misura dell'altro sito) */
  .flag-btn {
    width: 22px;
    height: 15px;
    border-radius: 3px;
    overflow: hidden;
    opacity: 0.4;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }
  .flag-btn svg { width: 100%; height: 100%; display: block; }
  .flag-btn:hover { opacity: 0.8; }
  .flag-btn.is-active {
    opacity: 1;
    transform: scale(1.15);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.85);
  }

  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--d, 0ms);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (max-width: 767px) {
    .team-card.reveal {
      opacity: 1;
      transform: none;
    }
  }

  .team-card {
    transition: box-shadow 0.4s ease, translate 0.4s ease;
  }
  @media (min-width: 768px) {
    .team-card:hover {
      translate: 0 -6px;
      box-shadow: 0 20px 45px rgba(255, 255, 255, 0.12);
    }
  }

  /* Team: scorrimento orizzontale, manina, niente selezione blu */
  .team-track {
    overscroll-behavior-x: contain;
    user-select: none;
    -webkit-user-select: none;
  }
  .team-track,
  .team-card,
  .team-card * { cursor: pointer; }
</style>

<script>
  import { autoScroll } from '../scripts/autoscroll.js';

  class AboutPage extends HTMLElement {
    timers = [];
    observer = null;
    stopScroll = null;

    connectedCallback() {
      // 1. Dissolvenza all'ingresso
      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              this.observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      this.querySelectorAll('.reveal').forEach((el) => this.observer.observe(el));

      // 2. Cambio lingua con le bandierine
      const AUTO_MS = 0; // 0 = solo al clic. Per il cambio automatico: es. 15000
      const flags = Array.from(this.querySelectorAll('.flag-btn'));
      const codes = flags.map((f) => f.getAttribute('data-lang'));
      let current = 0;
      let autoTimer = 0;

      const setLang = (i) => {
        current = i;
        this.setAttribute('data-active', codes[i]);
        flags.forEach((f, k) => f.classList.toggle('is-active', k === i));
      };

      const startAuto = () => {
        clearInterval(autoTimer);
        if (AUTO_MS > 0) {
          autoTimer = window.setInterval(() => setLang((current + 1) % codes.length), AUTO_MS);
          this.timers.push(autoTimer);
        }
      };

      flags.forEach((f, i) => {
        f.addEventListener('click', () => {
          setLang(i);
          startAuto();
        });
      });
      startAuto();

      // 3. Scorrimento automatico del team su mobile (il dito lo ferma, riparte 1s dopo il rilascio)
      const isMobile = window.matchMedia('(max-width: 767px)').matches;
      const track = this.querySelector('#team-track');
      if (isMobile && track) {
        this.stopScroll = autoScroll(track, { speed: 35, resumeMs: 1000 });
      }
    }

    disconnectedCallback() {
      this.timers.forEach((t) => clearTimeout(t));
      this.timers = [];
      if (this.observer) this.observer.disconnect();
      if (this.stopScroll) this.stopScroll();
    }
  }

  if (!customElements.get('about-page')) {
    customElements.define('about-page', AboutPage);
  }
</script>